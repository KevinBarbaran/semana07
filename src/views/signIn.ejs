<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex items-center justify-center p-4 selection:bg-indigo-500 selection:text-white">

    <div class="w-full max-w-md animate__animated animate__zoomIn">
        <!-- Tarjeta Principal con efecto Glass -->
        <div class="bg-slate-900/80 backdrop-blur-xl border border-slate-800 rounded-2xl shadow-2xl p-8 relative overflow-hidden">
            <div class="absolute -top-12 -right-12 w-32 h-32 bg-indigo-600/20 rounded-full blur-2xl pointer-events-none"></div>

            <div class="text-center space-y-2 mb-8">
                <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-indigo-600/20 text-indigo-400 border border-indigo-500/30 mb-2">
                    <i class="fa-solid fa-shield-halved text-xl"></i>
                </div>
                <h2 class="text-2xl font-bold tracking-tight text-slate-100">Bienvenido de Nuevo</h2>
                <p class="text-xs text-slate-400">Ingresa tus credenciales para acceder a la plataforma</p>
            </div>

            <!-- Formulario -->
            <form id="signInForm" class="space-y-5">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Correo Electrónico</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-500">
                            <i class="fa-solid fa-envelope text-sm"></i>
                        </span>
                        <input id="email" type="email" required placeholder="usuario@ejemplo.com"
                            class="w-full pl-10 pr-4 py-2.5 bg-slate-950/60 border border-slate-800 rounded-xl text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition duration-200 text-sm">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Contraseña</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-500">
                            <i class="fa-solid fa-lock text-sm"></i>
                        </span>
                        <input id="password" type="password" required placeholder="••••••••"
                            class="w-full pl-10 pr-4 py-2.5 bg-slate-950/60 border border-slate-800 rounded-xl text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition duration-200 text-sm">
                    </div>
                </div>

                <!-- Notificaciones dinámicas -->
                <div id="alertBox" class="hidden p-3 rounded-xl text-xs font-medium border animate__animated animate__fadeIn"></div>

                <button type="submit" id="btnSubmit"
                    class="w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl shadow-lg shadow-indigo-600/25 transition-all duration-200 flex items-center justify-center gap-2 group">
                    <span>Iniciar Sesión</span>
                    <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1"></i>
                </button>
            </form>

            <div class="mt-8 pt-6 border-t border-slate-800/80 text-center">
                <p class="text-xs text-slate-400">
                    ¿Aún no tienes una cuenta? 
                    <a href="/signUp" class="text-indigo-400 hover:text-indigo-300 font-semibold transition hover:underline">Regístrate gratis</a>
                </p>
            </div>
        </div>
    </div>

    <script>
        const form = document.getElementById('signInForm');
        const alertBox = document.getElementById('alertBox');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            showAlert('', false);

            const email = document.getElementById('email').value.trim();
            const password = document.getElementById('password').value;

            try {
                const res = await fetch('/api/auth/signIn', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password })
                });

                const data = await res.json();

                if (!res.ok) {
                    showAlert(data.message || 'Credenciales inválidas', true);
                    return;
                }

                sessionStorage.setItem('token', data.token);

                // Decodificar JWT para conocer rol
                const payload = JSON.parse(atob(data.token.split('.')[1]));
                showAlert('Autenticación exitosa. Redirigiendo...', false, 'green');

                setTimeout(() => {
                    if (payload.roles && payload.roles.includes('admin')) {
                        window.location.href = '/dashboard-admin';
                    } else {
                        window.location.href = '/dashboard-user';
                    }
                }, 1000);

            } catch (err) {
                showAlert('Error de conexión con el servidor', true);
            }
        });

        function showAlert(msg, isError, type = 'red') {
            if (!msg) {
                alertBox.classList.add('hidden');
                return;
            }
            alertBox.classList.remove('hidden', 'bg-rose-950/50', 'border-rose-800', 'text-rose-300', 'bg-emerald-950/50', 'border-emerald-800', 'text-emerald-300');
            
            if (isError || type === 'red') {
                alertBox.classList.add('bg-rose-950/50', 'border-rose-800', 'text-rose-300');
            } else {
                alertBox.classList.add('bg-emerald-950/50', 'border-emerald-800', 'text-emerald-300');
            }
            alertBox.textContent = msg;
        }
    </script>
</body>
</html>