<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil de Usuario</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white">

    <!-- Header Bar -->
    <header class="bg-slate-900/80 backdrop-blur-md border-b border-slate-800">
        <div class="max-w-4xl mx-auto px-4 py-3.5 flex items-center justify-between">
            <button onclick="goBack()" class="text-xs font-semibold text-slate-400 hover:text-slate-200 transition flex items-center gap-2">
                <i class="fa-solid fa-chevron-left"></i> Volver al Panel
            </button>
            <button onclick="logout()" class="text-xs font-semibold text-rose-400 hover:text-rose-300 transition">
                Cerrar Sesión
            </button>
        </div>
    </header>

    <main class="max-w-2xl mx-auto px-4 py-10 flex-1 w-full space-y-6">

        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl shadow-xl p-6 sm:p-8 space-y-6">
            <div class="flex items-center gap-4 border-b border-slate-800 pb-6">
                <div id="avatarContainer" class="w-16 h-16 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-slate-400 overflow-hidden text-2xl font-bold">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div>
                    <h2 class="text-xl font-bold text-slate-100" id="profileTitleName">Configuración de Perfil</h2>
                    <p class="text-xs text-slate-400">Actualiza tus datos de contacto y dirección</p>
                </div>
            </div>

            <form id="profileForm" class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Nombre</label>
                        <input id="name" type="text" required
                            class="w-full px-3.5 py-2.5 bg-slate-950/60 border border-slate-800 rounded-xl text-slate-200 focus:outline-none focus:border-indigo-500 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Apellido</label>
                        <input id="lastName" type="text" required
                            class="w-full px-3.5 py-2.5 bg-slate-950/60 border border-slate-800 rounded-xl text-slate-200 focus:outline-none focus:border-indigo-500 text-sm">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Teléfono</label>
                    <input id="phoneNumber" type="text" required
                        class="w-full px-3.5 py-2.5 bg-slate-950/60 border border-slate-800 rounded-xl text-slate-200 focus:outline-none focus:border-indigo-500 text-sm">
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Dirección</label>
                    <input id="address" type="text" placeholder="Ej: Av. Principal 123"
                        class="w-full px-3.5 py-2.5 bg-slate-950/60 border border-slate-800 rounded-xl text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 text-sm">
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">URL Foto de Perfil</label>
                    <input id="url_profile" type="url" placeholder="https://..."
                        class="w-full px-3.5 py-2.5 bg-slate-950/60 border border-slate-800 rounded-xl text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 text-sm">
                </div>

                <div id="alertBox" class="hidden p-3 rounded-xl text-xs font-medium border"></div>

                <div class="pt-2">
                    <button type="submit"
                        class="w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl shadow-lg shadow-indigo-600/25 transition-all">
                        Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </main>

    <script>
        const token = sessionStorage.getItem('token');
        if (!token) window.location.href = '/signIn';
        let currentUserRole = 'user';

        async function loadProfile() {
            try {
                const res = await fetch('/api/users/me', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });

                if (!res.ok) {
                    sessionStorage.removeItem('token');
                    window.location.href = '/signIn';
                    return;
                }

                const user = await res.json();
                document.getElementById('name').value = user.name || '';
                document.getElementById('lastName').value = user.lastName || '';
                document.getElementById('phoneNumber').value = user.phoneNumber || '';
                document.getElementById('address').value = user.address || '';
                document.getElementById('url_profile').value = user.url_profile || '';

                if (user.url_profile) {
                    document.getElementById('avatarContainer').innerHTML = `<img src="${user.url_profile}" class="w-full h-full object-cover">`;
                }

                const payload = JSON.parse(atob(token.split('.')[1]));
                if (payload.roles && payload.roles.includes('admin')) {
                    currentUserRole = 'admin';
                }

            } catch (err) {
                console.error(err);
            }
        }

        document.getElementById('profileForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            showAlert('');

            const body = {
                name: document.getElementById('name').value,
                lastName: document.getElementById('lastName').value,
                phoneNumber: document.getElementById('phoneNumber').value,
                address: document.getElementById('address').value,
                url_profile: document.getElementById('url_profile').value
            };

            const res = await fetch('/api/users/me', {
                method: 'PUT',
                headers: { 
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify(body)
            });

            if (res.ok) {
                showAlert('Información actualizada con éxito', false);
            } else {
                showAlert('No se pudieron guardar los cambios', true);
            }
        });

        function showAlert(msg, isError = false) {
            const alertBox = document.getElementById('alertBox');
            if (!msg) {
                alertBox.classList.add('hidden');
                return;
            }
            alertBox.classList.remove('hidden', 'bg-rose-950/50', 'border-rose-800', 'text-rose-300', 'bg-emerald-950/50', 'border-emerald-800', 'text-emerald-300');
            
            if (isError) {
                alertBox.classList.add('bg-rose-950/50', 'border-rose-800', 'text-rose-300');
            } else {
                alertBox.classList.add('bg-emerald-950/50', 'border-emerald-800', 'text-emerald-300');
            }
            alertBox.textContent = msg;
        }

        function goBack() {
            window.location.href = currentUserRole === 'admin' ? '/dashboard-admin' : '/dashboard-user';
        }

        function logout() {
            sessionStorage.removeItem('token');
            window.location.href = '/signIn';
        }

        loadProfile();
    </script>
</body>
</html>