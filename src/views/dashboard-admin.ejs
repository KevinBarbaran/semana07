<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administración</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white">

    <!-- Header Navigation -->
    <header class="bg-slate-900/80 backdrop-blur-md border-b border-slate-800 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3.5 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center font-bold text-white shadow-md shadow-indigo-600/30">
                    A
                </div>
                <span class="font-semibold text-slate-200 tracking-wide text-sm sm:text-base">Administración</span>
            </div>
            <div class="flex items-center gap-3">
                <a href="/profile" class="px-3.5 py-2 text-xs sm:text-sm font-medium text-slate-300 bg-slate-800 hover:bg-slate-700/80 rounded-xl border border-slate-700/50 transition">
                    <i class="fa-solid fa-user-gear mr-1.5"></i> Perfil
                </a>
                <button onclick="logout()" class="px-3.5 py-2 text-xs sm:text-sm font-medium text-rose-400 bg-rose-950/40 hover:bg-rose-900/60 rounded-xl border border-rose-800/40 transition">
                    <i class="fa-solid fa-power-off mr-1.5"></i> Salir
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 py-8 flex-1 w-full space-y-6">

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-slate-100">Usuarios Registrados</h1>
                <p class="text-xs text-slate-400">Listado general de cuentas y roles en la plataforma</p>
            </div>
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs text-slate-300">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>Total: <strong id="userCount" class="text-indigo-400">0</strong></span>
            </div>
        </div>

        <!-- Tabla -->
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl shadow-xl overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-300">
                    <thead class="bg-slate-950/80 text-xs font-semibold uppercase tracking-wider text-slate-400 border-b border-slate-800">
                        <tr>
                            <th class="px-6 py-4">Usuario</th>
                            <th class="px-6 py-4">Contacto</th>
                            <th class="px-6 py-4">Edad</th>
                            <th class="px-6 py-4">Roles</th>
                            <th class="px-6 py-4 text-right">Acción</th>
                        </tr>
                    </thead>
                    <tbody id="usersTableBody" class="divide-y divide-slate-800/60">
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center text-slate-500">Cargando registros...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script>
        const token = sessionStorage.getItem('token');
        if (!token) window.location.href = '/signIn';

        async function loadUsers() {
            try {
                const res = await fetch('/api/users', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });

                if (res.status === 403) {
                    window.location.href = '/403';
                    return;
                }

                if (!res.ok) {
                    sessionStorage.removeItem('token');
                    window.location.href = '/signIn';
                    return;
                }

                const users = await res.json();
                document.getElementById('userCount').textContent = users.length;

                const tbody = document.getElementById('usersTableBody');
                tbody.innerHTML = users.map(u => {
                    const roleBadges = (u.roles || []).map(r => {
                        const name = typeof r === 'object' ? r.name : r;
                        const isAdmin = name === 'admin';
                        return `<span class="px-2 py-0.5 rounded text-[10px] font-semibold tracking-wider uppercase border ${isAdmin ? 'bg-indigo-950/60 text-indigo-300 border-indigo-800' : 'bg-slate-800 text-slate-400 border-slate-700'}">${name}</span>`;
                    }).join(' ');

                    return `
                        <tr class="hover:bg-slate-800/40 transition-colors">
                            <td class="px-6 py-4">
                                <div class="font-medium text-slate-200">${u.name} ${u.lastName || ''}</div>
                                <div class="text-xs text-slate-500">${u.email}</div>
                            </td>
                            <td class="px-6 py-4 text-xs text-slate-400">
                                ${u.phoneNumber || 'Sin registro'}
                            </td>
                            <td class="px-6 py-4 text-xs">
                                <span class="font-medium text-slate-300">${u.age !== null ? u.age + ' años' : 'N/A'}</span>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex gap-1">${roleBadges}</div>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <button onclick="viewUser('${u._id}')" class="p-2 text-slate-400 hover:text-indigo-400 transition">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                }).join('');

            } catch (err) {
                console.error(err);
            }
        }

        function logout() {
            sessionStorage.removeItem('token');
            window.location.href = '/signIn';
        }

        function viewUser(id) {
            alert('ID de Usuario seleccionado: ' + id);
        }

        loadUsers();
    </script>
</body>
</html>